<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Cx1 Results Viewer</title>
  <link rel="stylesheet" href="/web/static/style.css">
  <script type="importmap">
  {
    "imports": {
      "codemirror": "https://esm.sh/codemirror@6.0.2?deps=@codemirror/view@6.43.7,@codemirror/state@6.7.1",
      "@codemirror/state": "https://esm.sh/@codemirror/state@6.7.1",
      "@codemirror/view": "https://esm.sh/@codemirror/view@6.43.7?deps=@codemirror/state@6.7.1"
    }
  }
  </script>
</head>
<body>
  <h1>Cx1 Results Viewer</h1>

  <form method="POST" action="/load" class="url-form">
    <input type="text" name="url" value="{{.URL}}" size="120"
           placeholder="Paste Checkmarx One result URL...">
    <button type="submit">Go</button>
  </form>

  {{if .HasError}}
    <p class="error">Error: {{.ErrorMessage}}</p>
  {{end}}

  {{if .HasResults}}
    <div class="codeboxes">
      {{range .CodeBoxes}}
        <section class="codebox" data-role="codebox">
          <div class="codebox-header">
            <div class="codebox-header-row">
              <span class="codebox-title">{{.FilePath}} : lines {{.MinLine}}-{{.MaxLine}} ({{.QueryName}})</span>
              <div class="codebox-buttons">
                <button type="button" class="codebox-btn" data-action="maximize" title="Maximize" aria-label="Maximize">
                  <svg viewBox="0 0 16 16" width="15" height="15"><path d="M2 2h5v2H4v3H2V2zm12 0v5h-2V4h-3V2h5zM2 14v-5h2v3h3v2H2zm12 0h-5v-2h3v-3h2v5z" fill="currentColor"/></svg>
                </button>
                <button type="button" class="codebox-btn" data-action="reset" title="Reset size" aria-label="Reset size">
                  <svg viewBox="0 0 16 16" width="15" height="15"><path d="M13.65 2.35A6.5 6.5 0 1 0 15 8h-1.5a5 5 0 1 1-1.06-3.54L10 7h5V2l-1.35 1.35z" fill="currentColor"/></svg>
                </button>
                <button type="button" class="codebox-btn" data-action="toggle-list" title="Toggle steps" aria-label="Toggle steps" aria-pressed="true">
                  <svg viewBox="0 0 16 16" width="15" height="15"><path d="M2 3h12v2H2V3zm0 4h12v2H2V7zm0 4h12v2H2v-2z" fill="currentColor"/></svg>
                </button>
              </div>
            </div>
            <ol class="codebox-steps">
              {{range .Highlights}}
                <li>{{.Name}} <span class="codebox-step-loc">(line {{.Line}}, col {{.Column}})</span></li>
              {{end}}
            </ol>
          </div>
          <div class="codebox-resize-handle codebox-resize-top" data-role="resize-handle" data-edge="top" aria-hidden="true"></div>
          <div class="codebox-editor"></div>
          <div class="codebox-resize-handle codebox-resize-bottom" data-role="resize-handle" data-edge="bottom" aria-hidden="true"></div>
          <script type="application/json" class="codebox-payload">{{.DataJSON}}</script>
        </section>
      {{end}}
    </div>
  {{end}}

  <script type="module" src="/web/static/viewer.js"></script>
</body>
</html>
